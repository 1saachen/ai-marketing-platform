{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fission-clone-task-create.schema.json",
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "sourceInput": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifactId",
        "revision",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "sourceAnalysis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifactId",
            "revision",
            "contentHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedDraftRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedArtifactRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "SMART_MATCH",
            "VALIDATE_KEEP_TEXT"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "idempotencyKey",
    "sourceInput",
    "sourceAnalysis",
    "expectedDraftRevision",
    "expectedArtifactRevision",
    "purpose"
  ],
  "additionalProperties": false
}
