{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fission-clone-generation-variant-review.schema.json",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "verdict": {
            "type": "string",
            "enum": ["PASSED", "FAILED"]
          },
          "reason": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          }
        },
        "required": ["variantId", "verdict", "reason"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 20
    }
  },
  "required": ["checks"],
  "additionalProperties": false
}
