{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fission-avatar-long-sync-completion.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "audioDurationMs": {
      "type": "integer",
      "minimum": 60900,
      "maximum": 90000
    },
    "videoDurationMs": {
      "type": "integer",
      "minimum": 61000,
      "maximum": 90000
    },
    "audioLagMs": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "minimumAudioCorrelationPermille": {
      "type": "integer",
      "minimum": 980,
      "maximum": 1000
    },
    "wordTimings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1
          },
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 89999
          },
          "endMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90000
          },
          "confidencePermille": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["text", "startMs", "endMs", "confidencePermille"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2880
    },
    "seamTimesMs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 89999
      },
      "minItems": 2,
      "maxItems": 11
    }
  },
  "required": [
    "schemaVersion",
    "audioDurationMs",
    "videoDurationMs",
    "audioLagMs",
    "minimumAudioCorrelationPermille",
    "wordTimings",
    "seamTimesMs"
  ],
  "additionalProperties": false
}
