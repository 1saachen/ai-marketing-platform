{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fission-clone-input.schema.json",
  "title": "CloneInputDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "referenceUploadId",
    "productUploadIds",
    "productName",
    "productFacts",
    "sourceRightsConfirmed"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "referenceUploadId": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "productUploadIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "description": "Upload UUIDs; the shared parser additionally rejects case-insensitive duplicates.",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    },
    "productName": {
      "type": "string",
      "maxLength": 200
    },
    "productFacts": {
      "type": "string",
      "maxLength": 20000
    },
    "sourceRightsConfirmed": {
      "type": "boolean"
    }
  }
}
